# Pulse — sample env. Copy to .env for development, or set the API key from the in-app Settings panel.
# In production, the key is stored in macOS Keychain via Electron safeStorage.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use for reports and suggestions.
PULSE_MODEL=claude-sonnet-4-6

# Optional: when the daily report fires (cron expression, local time). Default = 18:30 every day.
PULSE_DAILY_CRON=30 18 * * *
