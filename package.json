{
  "name": "pulse-productivity-os",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse — a local-first macOS productivity OS that tracks your day, gives AI reports, and measures whether you act on its suggestions.",
  "author": "Siddharth Chauhan",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "package:mac": "electron-vite build && electron-builder --mac --arm64 --x64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "active-win": "^8.2.1",
    "better-sqlite3": "^11.7.0",
    "electron-store": "^10.0.0",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.siddharth.pulse",
    "productName": "Pulse",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Pulse uses Apple Events to read the active window title for activity tracking.",
        "LSUIElement": false
      }
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ]
  }
}
